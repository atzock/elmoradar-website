# Twitch API Credentials
# You can get these from https://dev.twitch.tv/console/apps
# 1. Create a new application
# 2. Copy your Client ID
# 3. Generate an App Access Token via OAuth

TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_APP_ACCESS_TOKEN=your_twitch_app_access_token

TWITCH_CLIENT_ID=your_twitch_app_client_id
TWITCH_APP_ACCESS_TOKEN=your_twitch_app_access_token

# Contact form — SMTP (Gmail: use an App Password, not your normal password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=elmoradar@gmail.com
SMTP_PASS=your_app_password_here
SMTP_TO=elmoradar@gmail.com
